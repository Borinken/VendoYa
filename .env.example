# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption Configuration (CRITICAL SECURITY)
# Generate a strong random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this key to version control
# Store securely in Vercel environment variables
ENCRYPTION_MASTER_KEY=your-super-secret-encryption-key-here-generate-with-crypto

# Cron Security (Vercel Cron authentication)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret-here-generate-with-crypto

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

