# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Pagos)
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_BASICO=price_your_basico_price_id
STRIPE_PRICE_PROFESIONAL=price_your_profesional_price_id
STRIPE_PRICE_EMPRESAS=price_your_empresas_price_id

# Polycam API - Tours 3D (FREE: 10 scans/mes)
# 1. Crea cuenta en https://poly.cam
# 2. Ve a Settings → API Keys → Create New API Key
# 3. Copia la key (empieza con pk_)
POLYCAM_API_KEY=pk_your_polycam_api_key_here

# Webhook secret (opcional) - Para recibir notificaciones de Polycam
POLYCAM_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Encryption Configuration (CRITICAL SECURITY)
# Generate a strong random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this key to version control
# Store securely in Vercel environment variables
ENCRYPTION_MASTER_KEY=your-super-secret-encryption-key-here-generate-with-crypto

# Cron Security (Vercel Cron authentication)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret-here-generate-with-crypto

# App
NEXT_PUBLIC_APP_URL=https://vendoya.es


